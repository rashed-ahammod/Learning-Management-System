# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# --- Secrets --------------------------------------------------------------
# Generate your own before running. Quick way to get a value:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database -------------------------------------------------------------
# Local development runs on SQLite so there is nothing to install.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# On Railway, switch to the Postgres service it provisions:
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/railway
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Frontend -------------------------------------------------------------
# Origin allowed to call this API (CORS). The deployed Vercel URL in production.
FRONTEND_URL=http://localhost:3000
