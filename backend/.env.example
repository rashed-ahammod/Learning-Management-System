# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# Set both of these when deploying behind a proxy such as Railway.
# PUBLIC_URL is the address browsers use; without it Strapi builds absolute
# URLs from the request and gets http:// where the browser expects https://,
# which leaves the admin panel loading a blank page.
# PUBLIC_URL=https://your-app.up.railway.app
# IS_PROXIED=true

# --- Secrets --------------------------------------------------------------
# Generate your own before running. Quick way to get a value:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database -------------------------------------------------------------
# Local development runs on SQLite so there is nothing to install.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# On Railway, switch to the Postgres service it provisions. DATABASE_URL is
# supplied by Railway; when it is set the discrete settings below are ignored.
# DATABASE_CLIENT=postgres
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Frontend -------------------------------------------------------------
# Origins allowed to call this API from a browser (CORS).
# Comma-separated, because Vercel gives every preview deployment its own host.
FRONTEND_URL=http://localhost:3000

# --- First admin account --------------------------------------------------
# Optional. If set, an application admin with these credentials is created on
# boot when it does not already exist. Needed on a fresh deploy, because the
# endpoint that assigns roles is itself admin-only - without this there is no
# way to promote the first user. Leave unset to skip.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_USERNAME=admin
