# The variables to set on Railway. Copy the names, not the values.
#
# Railway provides PORT and, once a Postgres service is attached, DATABASE_URL.
# Everything else has to be set by hand under the service's Variables tab.

NODE_ENV=production
HOST=0.0.0.0

PUBLIC_URL=https://your-backend.up.railway.app
IS_PROXIED=true

# Comma-separated. Add preview domains here if you want previews to work.
FRONTEND_URL=https://your-frontend.vercel.app

DATABASE_CLIENT=postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Generate fresh values - do not reuse the ones from local development.
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Creates the first application admin on the first boot.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
