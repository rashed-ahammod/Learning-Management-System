{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz",
    "description": "An MCQ quiz attached to a course. Questions are components rather than their own collection, so a quiz is created, edited and versioned as one document."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course"
    },
    "questions": {
      "type": "component",
      "repeatable": true,
      "component": "quiz.question"
    }
  }
}
